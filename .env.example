# Used when running `pnpm dev`/`pnpm db:*` directly on the host against the
# dockerized Postgres (`docker compose up db`). Copy this file to `.env`.
# Inside `docker compose`, the `web` service gets its own DATABASE_URL pointing
# at the `db` service, so this file isn't read in that case.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mec_points
